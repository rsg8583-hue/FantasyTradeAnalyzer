# Copy to .env.local and fill in. Never commit real keys.
# ESPN credentials are NOT configured here: each user enters their own
# espn_s2/SWID cookies in the app, and they are kept only in server memory.

# Accounts and saved leagues. Locally they go in a SQLite file (default data/app.db).
# On Vercel (read-only disk) set the Turso pair instead; without it, sign-in is
# unavailable there but everything else still works.
# DATABASE_PATH=
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# AI explanations (optional). Without these the app still shows all calculated
# results, with a deterministic explanation and a "AI not configured" notice.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Any Responses-API model your account can use that supports structured outputs.
OPENAI_MODEL=gpt-5.5
